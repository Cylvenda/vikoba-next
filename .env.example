# Server-only URL used by the Next.js API proxy. Do not expose it with NEXT_PUBLIC_.
BACKEND_API_BASE=https://vikoba-api.onrender.com/api/

# Public canonical URL used by metadata, social cards, and the PWA.
NEXT_PUBLIC_SITE_URL=https://vikoba.cylvenda.co.tz

# Keep these aligned with the Django JWT/cookie lifetimes.
AUTH_COOKIE_ACCESS_MAX_AGE=3600
AUTH_COOKIE_REFRESH_MAX_AGE=7200
